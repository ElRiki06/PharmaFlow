{
  "expo": {
    "name": "PharmaFlow",
    "slug": "pharmaflow-universal",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ]
  }
}
